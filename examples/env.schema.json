{
  "DATABASE_URL": {
    "type": "url",
    "required": true,
    "description": "Primary database connection string"
  },
  "FEATURE_X_ENABLED": {
    "type": "bool",
    "required": false,
    "default": true,
    "description": "Enables feature X in the app"
  },
  "NODE_ENV": {
    "type": "enum",
    "required": true,
    "default": "development",
    "values": ["development", "staging", "production"],
    "description": "Runtime environment"
  },
  "PORT": {
    "type": "int",
    "required": false,
    "default": 3000,
    "description": "HTTP port"
  }
}
