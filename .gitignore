/target
**/*.rs.bk
.DS_Store

# Env files: gitignore everything in the .env family. zenv exists to prevent
# secret leaks; shipping a real .env in the zenv repo would be hypocritical.
# /bench writes .env fixtures to disk during benchmarking.
.env
.env.*
!.env.example
!examples/.env.example

# zenv schema convention: the project schema lives at the root, but we ship
# a reference schema under examples/.
env.schema.json
!examples/env.schema.json

distribution/
# Ignore everything in .claude/ EXCEPT the re-included mcp server below. Note:
# .claude/* (not .claude/) so git still descends into the re-included subdir --
# a bare .claude/ would make re-inclusion of any child impossible.
.claude/*
TODO.md
nul

# Local developer tooling -- not part of the public project.
.mcp.json
.mcp.json.example

# zenv-memory MCP server (local dev tooling): re-include the whole server dir.
# Within it, .claude/mcp/.gitignore excludes deps + churny runtime artifacts
# (node_modules, backups, audit ledger, archive, tmp, corrupt quarantine) while
# KEEPING the curated graph.json -- the recovery story + a reviewable diff of
# what Claude knows about this repo. The server source must not be lost either.
!.claude/mcp/
